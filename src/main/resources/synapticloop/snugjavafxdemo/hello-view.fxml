<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
			fx:controller="synapticloop.snugjavafxdemo.HelloController"
			stylesheets="@styles.css">
	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
	</padding>

	<ImageView fx:id="logoImage" preserveRatio="true" smooth="true"
				onMouseClicked="#onLogoMouseClick">
		<image>
			<Image url="@../../assets/images/snug-logo.png"/>
		</image>
	</ImageView>

	<Button fx:id="helloButton" text="Hello!" onAction="#onHelloButtonClick"/>

	<Label fx:id="welcomeText"/>
</VBox>
